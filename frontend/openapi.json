        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Fetched At"
     },
     "age_s": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "title": "Age S"
     },
