  "schemas": {
   "CongestionEdge": {
    "properties": {
     "a": {
      "prefixItems": [
       {
        "type": "number"
       },
       {
        "type": "number"
       }
      ],
      "type": "array",
      "maxItems": 2,
      "minItems": 2,
      "title": "A"
     },
     "b": {
      "prefixItems": [
       {
        "type": "number"
       },
       {
        "type": "number"
       }
      ],
      "type": "array",
      "maxItems": 2,
      "minItems": 2,
      "title": "B"
     },
     "ratio": {
      "type": "number",
      "title": "Ratio"
     },
     "road_class": {
      "type": "integer",
      "title": "Road Class"
     }
    },
    "type": "object",
    "required": [
     "a",
     "b",
     "ratio",
     "road_class"
    ],
    "title": "CongestionEdge"
   },
   "CongestionOut": {
    "properties": {
     "slot": {
      "type": "integer",
      "title": "Slot"
     },
     "label": {
      "type": "string",
      "title": "Label"
     },
     "edges": {
      "items": {
       "$ref": "#/components/schemas/CongestionEdge"
      },
      "type": "array",
      "title": "Edges"
     }
    },
    "type": "object",
    "required": [
     "slot",
     "label",
     "edges"
    ],
    "title": "CongestionOut"
   },
   "CustomerIn": {
    "properties": {
     "lon": {
      "type": "number",
      "title": "Lon"
     },
     "lat": {
      "type": "number",
      "title": "Lat"
     },
     "demand": {
      "type": "integer",
      "minimum": 1.0,
      "title": "Demand"
     }
    },
    "type": "object",
    "required": [
     "lon",
     "lat",
     "demand"
    ],
    "title": "CustomerIn"
   },
   "EmissionsOut": {
    "properties": {
     "kg": {
      "type": "number",
      "title": "Kg"
     },
     "label": {
      "type": "string",
      "title": "Label"
     }
    },
    "type": "object",
    "required": [
     "kg",
     "label"
    ],
    "title": "EmissionsOut"
   },
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "type": "array",
      "title": "Detail"
     }
    },
    "type": "object",
    "title": "HTTPValidationError"
   },
   "IncidentCreated": {
    "properties": {
     "job_id": {
      "type": "string",
      "title": "Job Id"
     },
     "affected_edges": {
      "type": "integer",
      "title": "Affected Edges"
     }
    },
    "type": "object",
    "required": [
     "job_id",
     "affected_edges"
    ],
    "title": "IncidentCreated"
   },
   "IncidentRequest": {
    "properties": {
     "job_id": {
      "type": "string",
      "title": "Job Id"
     },
     "edges": {
      "anyOf": [
       {
        "items": {
         "type": "integer"
        },
        "type": "array"
       },
       {
        "type": "null"
       }
      ],
      "title": "Edges"
     },
     "polygon": {
      "anyOf": [
       {
        "items": {
         "prefixItems": [
          {
           "type": "number"
          },
          {
           "type": "number"
          }
         ],
         "type": "array",
         "maxItems": 2,
         "minItems": 2
        },
        "type": "array"
       },
       {
        "type": "null"
       }
      ],
      "title": "Polygon"
     },
     "factor": {
      "type": "number",
      "maximum": 1.0,
      "exclusiveMinimum": 0.0,
      "title": "Factor",
      "default": 0.1
     },
     "t_start": {
      "type": "number",
      "title": "T Start"
     },
     "t_end": {
      "type": "number",
      "title": "T End"
     },
     "budget_s": {
      "type": "number",
      "maximum": 120.0,
      "minimum": 1.0,
      "title": "Budget S",
      "default": 10.0
     },
     "mu": {
      "type": "number",
      "minimum": 0.0,
      "title": "Mu",
      "default": 0.0
     },
     "seed": {
      "type": "integer",
      "title": "Seed",
      "default": 0
     }
    },
    "type": "object",
    "required": [
     "job_id",
     "t_start",
     "t_end"
    ],
    "title": "IncidentRequest"
   },
   "InstanceCreate": {
    "properties": {
     "name": {
      "anyOf": [
       {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{1,64}$"
       },
       {
        "type": "null"
       }
      ],
      "title": "Name"
     },
     "depot_lon": {
      "type": "number",
      "title": "Depot Lon"
     },
     "depot_lat": {
      "type": "number",
      "title": "Depot Lat"
     },
     "customers": {
      "items": {
       "$ref": "#/components/schemas/CustomerIn"
      },
      "type": "array",
      "maxItems": 300,
      "minItems": 1,
      "title": "Customers"
     },
     "capacity": {
      "type": "integer",
      "minimum": 1.0,
      "title": "Capacity"
     },
     "n_vehicles": {
      "anyOf": [
       {
        "type": "integer",
        "minimum": 1.0
       },
       {
        "type": "null"
       }
      ],
      "title": "N Vehicles"
     },
     "depart_s": {
      "type": "number",
      "title": "Depart S",
      "default": 63000.0
     }
    },
    "type": "object",
    "required": [
     "depot_lon",
     "depot_lat",
     "customers",
     "capacity"
    ],
    "title": "InstanceCreate"
   },
   "InstanceDetail": {
    "properties": {
     "name": {
      "type": "string",
      "title": "Name"
     },
     "n_customers": {
      "type": "integer",
      "title": "N Customers"
     },
     "n_vehicles": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "title": "N Vehicles"
     },
     "capacity": {
      "type": "integer",
      "title": "Capacity"
     },
     "depart_s": {
      "type": "number",
      "title": "Depart S"
     },
     "speed_source": {
      "type": "string",
      "title": "Speed Source",
      "default": "Calibrated time-of-day profile (synthetic)"
     },
     "depot": {
      "prefixItems": [
       {
        "type": "number"
       },
       {
        "type": "number"
       }
      ],
      "type": "array",
      "maxItems": 2,
      "minItems": 2,
      "title": "Depot"
     },
     "customers": {
      "items": {
       "$ref": "#/components/schemas/CustomerIn"
      },
      "type": "array",
      "title": "Customers"
     },
     "bbox": {
      "prefixItems": [
       {
        "type": "number"
       },
       {
        "type": "number"
       },
       {
        "type": "number"
       },
       {
        "type": "number"
       }
      ],
      "type": "array",
      "maxItems": 4,
      "minItems": 4,
      "title": "Bbox"
     }
    },
    "type": "object",
    "required": [
     "name",
     "n_customers",
     "n_vehicles",
     "capacity",
     "depart_s",
     "depot",
     "customers",
     "bbox"
    ],
    "title": "InstanceDetail"
   },
   "JobStatus": {
    "properties": {
     "job_id": {
      "type": "string",
      "title": "Job Id"
     },
     "kind": {
      "type": "string",
      "enum": [
       "solve",
       "incident"
      ],
      "title": "Kind"
     },
     "state": {
      "type": "string",
      "enum": [
       "idle",
       "solving",
       "safe_plan",
       "optimising",
       "done",
       "error",
       "stopped"
      ],
      "title": "State"
     },
     "elapsed_s": {
      "type": "number",
      "title": "Elapsed S"
     },
     "message": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Message"
     },
     "solution": {
      "anyOf": [
       {
        "$ref": "#/components/schemas/SolutionOut"
       },
       {
        "type": "null"
       }
      ]
     },
     "run_id": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Run Id"
     }
    },
    "type": "object",
    "required": [
     "job_id",
     "kind",
     "state",
     "elapsed_s"
    ],
    "title": "JobStatus"
   },
   "LiveOut": {
    "properties": {
