FROM node:lts-slim AS ui
WORKDIR /app
COPY frontend/package*.json ./
RUN npm ci
COPY frontend .
RUN npm run build

FROM python:3.11-slim
ENV NUMBA_NUM_THREADS=1 OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
WORKDIR /app
COPY backend/requirements.lock backend/pyproject.toml ./backend/
RUN pip install --no-cache-dir -r backend/requirements.lock
COPY backend ./backend
COPY configs ./configs
RUN pip install --no-cache-dir -e backend
# runtime data only (raw/ is 600+ MB of source downloads and is not needed to serve)
COPY data/scenarios ./data/scenarios
COPY data/processed ./data/processed
COPY results ./results
COPY --from=ui /app/dist /app/ui
WORKDIR /app/backend
EXPOSE 8000
CMD ["uvicorn", "taqpso.api.web:app", "--host", "0.0.0.0", "--port", "8000"]
